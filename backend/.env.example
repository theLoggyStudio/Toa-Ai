# Tarification
PRICE_PER_BUBBLE_CFA=75

# Mode test local (true = pas de PayDunya, bouton "Lancer la traduction")
DISABLE_PAYMENT=false

# OCR rapide pour tests (true = pas de manga-ocr / easyocr lourd)
OCR_FAST_MODE=false
# OCR profond (true = seconde passe OCR avec prétraitements pour récupérer les textes ratés)
OCR_DEEP_MODE=true

# PayDunya (ne jamais committer le .env réel)
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_TEST_PUBLIC_KEY=
PAYDUNYA_TEST_PRIVATE_KEY=
PAYDUNYA_TEST_TOKEN=
PAYDUNYA_PROD_PUBLIC_KEY=
PAYDUNYA_PROD_PRIVATE_KEY=
PAYDUNYA_PROD_TOKEN=

# Frontend (Vercel) pour CORS et redirections PayDunya
# Plusieurs URLs : FRONTEND_ORIGIN=http://localhost:5173,https://votre-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Cursor API (traduction)
CURSOR_API_KEY=
CURSOR_MODEL=auto
# Optionnel: dossier du workspace pour l'agent local Cursor SDK
CURSOR_WORKSPACE_DIR=../

# Rendu immersion: texte vertical (caractere par caractere, haut -> bas)
IMMERSION_VERTICAL_TEXT=false

# Police custom (optionnel): chemin relatif depuis backend/ ou chemin absolu
# Exemple relatif: MANGA_FONT_PATH=assets/fonts/WildWordsRoman.ttf
MANGA_FONT_PATH=

# Preset auto (optionnel): police dialogue vs onomatopees
MANGA_DIALOGUE_FONT_PATH=
MANGA_SFX_FONT_PATH=

# Dictionnaires RAG (JMdict japonais + Kengdic coréen, téléchargés dans data/glossaries/)
GLOSSARY_RAG_ENABLED=true
